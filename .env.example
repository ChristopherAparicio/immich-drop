# Local development only. Production values live on the NAS and secrets are
# supplied as files. This service intentionally has no Immich connection.
HOST=0.0.0.0
PORT=8080
PUBLIC_BASE_URL=http://127.0.0.1:8080
COOKIE_SECURE=false

INCOMING_ROOT=/incoming
STATE_DB=/data/state.db
GLOBAL_BUDGET_BYTES=107374182400
DISK_RESERVE_BYTES=10737418240
DEFAULT_QUOTA_BYTES=1073741824
DEFAULT_MAX_FILE_BYTES=536870912
DEFAULT_MAX_FILES=500
UPLOAD_CHUNK_BYTES=8388608
INCOMPLETE_TTL_SECONDS=86400
SWEEP_INTERVAL_SECONDS=300
SESSION_MAX_AGE_SECONDS=43200
MAX_CLIENT_CONCURRENCY=2
MAX_ACTIVE_UPLOADS=3
MAX_ACTIVE_UNLOCKS=2
UPLOAD_CHUNK_TIMEOUT_SECONDS=180
MAX_INVITE_TTL_SECONDS=604800
LOG_LEVEL=INFO

# Development fallback only. Compose overrides this with SESSION_SECRET_FILE.
# Generate .local/session-secret with at least 32 random bytes before startup.
SESSION_SECRET=
